<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% set sayfaBasligi = (title + " - " + seo.ad) if (title and title != seo.ad) else seo.ad %}
  {% set aciklama = ozet or seo.aciklama %}
  {% set sayfaAdresi = seo.url + page.url %}
  <title>{{ sayfaBasligi }}</title>
  <meta name="description" content="{{ aciklama }}">
  <meta name="google-site-verification" content="0Gd2M5sxo-hzWEibIPWHY6pl0jmxpdMblWjFmA_Plbk" />
  <link rel="canonical" href="{{ sayfaAdresi }}">
  <meta property="og:site_name" content="{{ seo.ad }}">
  <meta property="og:locale" content="tr_TR">
  <meta property="og:type" content="{{ 'website' if page.url == '/' else 'article' }}">
  <meta property="og:title" content="{{ sayfaBasligi }}">
  <meta property="og:description" content="{{ aciklama }}">
  <meta property="og:url" content="{{ sayfaAdresi }}">
  <meta name="twitter:card" content="summary">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:wght@400;500;600&family=Inter:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="wrap">
    <header class="site-header">
      <a href="/" class="site-title">Kiş İki Bayit Bir</a>
      <p class="site-tagline">Hikâyeler, anılar ve yazılar</p>
    </header>
    <main>
      {{ content | safe }}
    </main>
    <footer class="site-footer">
      <p>Kiş İki Bayit Bir &middot; {{ currentYear }}</p>
    </footer>
  </div>
</body>
</html>
